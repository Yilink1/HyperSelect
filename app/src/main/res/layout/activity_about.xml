<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hyper_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAbout"
        android:layout_width="match_parent"
        android:layout_height="?attr/action Bar Size"
        android:background="@color/hyper_bg" />

    <androidx.core.widget.Nested ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fill Viewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding Start="16dp"
            android:padding End="16dp"
            android:padding Bottom="40dp">

            <!-- App Logo Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding Top="20dp"
                android:padding Bottom="24dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_about_logo_card">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_about_logo" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Hyper Select"
                    android:textColor="@color/hyper_text_primary"
                    android:textSize="22sp"
                    android:text Style="bold" />

                <TextView
                    android:id="@+id/tv About Version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="v1.0.0 (Release)"
                    android:textColor="@color/hyper_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section 1: Module Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin Start="8dp"
                android:layout_marginBottom="6dp"
                android:text="Module Info"
                android:textColor="@color/hyper_text_secondary"
                android:textSize="12sp"
                android:text Style="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row 1: Scope -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scope"
                        android:textColor="@color/hyper_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Framework &amp; Resolver"
                        android:textColor="@color/hyper_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hyper_divider" />

                <!-- Row 2: Environment -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Environment"
                        android:textColor="@color/hyper_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xiaomi Hyper OS"
                        android:textColor="@color/hyper_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Section 2: Help Guide Action -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin Start="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="Usage Guide"
                android:textColor="@color/hyper_text_secondary"
                android:textSize="12sp"
                android:text Style="bold" />

            <LinearLayout
                android:id="@+id/btn About Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_item_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" and Instructions"
                    android:textColor="@color/hyper_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/hyper_text_secondary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Section 3: Open Source -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin Start="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="Aboutand "
                android:textColor="@color/hyper_text_secondary"
                android:textSize="12sp"
                android:text Style="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_group"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Git Hub -->
                <LinearLayout
                    android:id="@+id/btn About Github"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_item_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Git Hub  "
                        android:textColor="@color/hyper_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yilink1/Hyper Select ›"
                        android:textColor="@color/hyper_accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hyper_divider" />

                <!-- Author -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=" "
                        android:textColor="@color/hyper_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yilink"
                        android:textColor="@color/hyper_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hyper_divider" />

                <!-- License -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=" License"
                        android:textColor="@color/hyper_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPL-3.0"
                        android:textColor="@color/hyper_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Translated by TofuGG"
                android:textColor="@color/hyper_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.Nested ScrollView>

</LinearLayout>
