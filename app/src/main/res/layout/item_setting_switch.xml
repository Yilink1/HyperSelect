<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_item"
    android:clickable="true"
    android:clipTo Outline="true"
    android:focusable="true"
    android:foreground="@drawable/bg_item_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BlockAI writing bubble"
            android:textColor="@color/hyper_text_primary"
            android:text Size="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="long pressTextwhen No more sticky notesAI  "
            android:textColor="@color/hyper_text_secondary"
            android:text Size="12sp" />
    </LinearLayout>

    <io.github.yilink1.hyperselect.HyperSwitch
        android:id="@+id/switchBlock AiWriting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp" />
</LinearLayout>
