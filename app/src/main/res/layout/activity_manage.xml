<?xml version="1.0" encoding="utf-8"?>
<!-- Three management pages（TextSelection / SystemShare / OpenWith）Sharedof theUnified  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:orientation="vertical">

    <!--  ：Back / title / Search / More；Search whenby searchBox Override -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <LinearLayout
            android:id="@+id/header Bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItem BackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/hyper_text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/hyper_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItem BackgroundBorderless"
                android:contentDescription="Search"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                app:tint="@color/hyper_text_primary" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItem BackgroundBorderless"
                android:contentDescription="More"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/hyper_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantFor Accessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/hyper_text_secondary" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Searchapp or "
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/hyper_text_primary"
                android:textColor Hint="@color/hyper_text_secondary"
                android:textCursor Drawable="@null"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnClose Search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItem BackgroundBorderless"
                android:contentDescription="DisableSearch"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                app:tint="@color/hyper_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- page of theSettings（TextSelectionpage 「BlockAI Writing」） -->
    <FrameLayout
        android:id="@+id/layoutExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Top dual-tab bar：Show / Hide（ ） -->
    <LinearLayout
        android:id="@+id/segment"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tvTab Visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTab Hidden"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp" />
    </LinearLayout>

    <!--  Tip -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:text="long pressordrag handleSort，Swipe leftto hide"
        android:textColor="@color/hyper_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.Recycler View
            android:id="@+id/recycler View"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipTo Padding="false"
            android:overScroll Mode="never"
            android:paddingTop="2dp"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress Bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/hyper_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/hyper_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Undo ：hide / Restore /  after  -->
        <LinearLayout
            android:id="@+id/undo Bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_undo_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUndo Msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/hyper_btn_primary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnUndo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItem Background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Undo"
                android:textColor="@color/hyper_undo_action"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
