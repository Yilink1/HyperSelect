<?xml version="1.0" encoding="utf-8"?>
<!-- Three management pages（Text Selection / System Share / Open With）Sharedof the Unified  -->
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:orientation="vertical">

    <!--  ：Back / title / Search / More；Search whenby search Box Override -->
    <Frame Layout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <Linear Layout
            android:id="@+id/header Bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding Start="6dp"
            android:padding End="8dp">

            <Image View
                android:id="@+id/btn Back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectable Item Background Borderless"
                android:content Description="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/hyper_text_primary" />

            <Text View
                android:id="@+id/tv Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin Start="4dp"
                android:layout_weight="1"
                android:single Line="true"
                android:text Color="@color/hyper_text_primary"
                android:text Size="20sp"
                android:text Style="bold" />

            <Image View
                android:id="@+id/btn Search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectable Item Background Borderless"
                android:content Description="Search"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                app:tint="@color/hyper_text_primary" />

            <Image View
                android:id="@+id/btn More"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectable Item Background Borderless"
                android:content Description="More"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/hyper_text_primary" />
        </Linear Layout>

        <Linear Layout
            android:id="@+id/search Box"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:layout_margin Horizontal="12dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding Start="16dp"
            android:padding End="4dp"
            android:visibility="gone">

            <Image View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:important For Accessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/hyper_text_secondary" />

            <Edit Text
                android:id="@+id/et Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin Start="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Searchapp or "
                android:ime Options="action Search"
                android:input Type="text"
                android:max Lines="1"
                android:text Color="@color/hyper_text_primary"
                android:text Color Hint="@color/hyper_text_secondary"
                android:text Cursor Drawable="@null"
                android:text Size="15sp" />

            <Image View
                android:id="@+id/btn Close Search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectable Item Background Borderless"
                android:content Description="Disable Search"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                app:tint="@color/hyper_text_secondary" />
        </Linear Layout>
    </Frame Layout>

    <!-- page of the Settings（Text Selectionpage 「Block AI Writing」） -->
    <Frame Layout
        android:id="@+id/layout Extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Horizontal="12dp"
        android:layout_margin Bottom="6dp"
        android:visibility="gone" />

    <!-- Top dual-tab bar：Show / Hide（ ） -->
    <Linear Layout
        android:id="@+id/segment"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_margin Horizontal="12dp"
        android:layout_margin Bottom="6dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <Text View
            android:id="@+id/tv Tab Visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text Size="14sp" />

        <Text View
            android:id="@+id/tv Tab Hidden"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text Size="14sp" />
    </Linear Layout>

    <!--  Tip -->
    <Text View
        android:id="@+id/tv Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Horizontal="20dp"
        android:layout_margin Bottom="6dp"
        android:text="long pressordrag handle Sort，Swipe leftto hide"
        android:text Color="@color/hyper_text_secondary"
        android:text Size="12sp"
        android:visibility="gone" />

    <Frame Layout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.Recycler View
            android:id="@+id/recycler View"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clip To Padding="false"
            android:over Scroll Mode="never"
            android:padding Top="2dp"
            android:padding Bottom="24dp" />

        <Progress Bar
            android:id="@+id/progress Bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate Tint="@color/hyper_accent"
            android:visibility="gone" />

        <Text View
            android:id="@+id/tv Empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text Color="@color/hyper_text_secondary"
            android:text Size="14sp"
            android:visibility="gone" />

        <!-- Undo ：hide / Restore /  after  -->
        <Linear Layout
            android:id="@+id/undo Bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:layout_margin Horizontal="24dp"
            android:layout_margin Bottom="28dp"
            android:background="@drawable/bg_undo_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding Start="20dp"
            android:visibility="gone">

            <Text View
                android:id="@+id/tv Undo Msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:single Line="true"
                android:text Color="@color/hyper_btn_primary_text"
                android:text Size="14sp" />

            <Text View
                android:id="@+id/btn Undo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectable Item Background"
                android:gravity="center"
                android:padding Horizontal="20dp"
                android:text="Undo"
                android:text Color="@color/hyper_undo_action"
                android:text Size="14sp"
                android:text Style="bold" />
        </Linear Layout>
    </Frame Layout>

</Linear Layout>
