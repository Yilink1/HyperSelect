<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin Top="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Frame Layout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle">

        <Image View
            android:id="@+id/iv Help Icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center" />
    </Frame Layout>

    <Linear Layout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin Start="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Text View
            android:id="@+id/tv Help Item Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text Color="@color/hyper_text_primary"
            android:text Size="15sp"
            android:text Style="bold" />

        <Text View
            android:id="@+id/tv Help Item Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin Top="3dp"
            android:line Spacing Extra="2dp"
            android:text Color="@color/hyper_desc_text"
            android:text Size="13sp" />
    </Linear Layout>

</Linear Layout>
