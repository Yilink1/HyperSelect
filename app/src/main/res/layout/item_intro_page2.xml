<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding Horizontal="24dp">

    <!-- Animation Viewport Card -->
    <androidx.cardview.widget.Card View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        app:card Background Color="@color/hyper_card_bg"
        app:card Corner Radius="24dp"
        app:card Elevation="2dp">

        <Linear Layout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding Horizontal="20dp">

            <!-- Floating selection menu (mirrors real Hyper OS popup) -->
            <androidx.cardview.widget.Card View
                android:id="@+id/card Page2Menu"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                app:card Background Color="@color/hyper_menu_bg"
                app:card Corner Radius="18dp"
                app:card Elevation="8dp">

                <Linear Layout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding Vertical="6dp">

                    <Text View
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="←"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="16sp"
                        android:text Style="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin Horizontal="12dp"
                        android:background="@color/hyper_divider" />

                    <Text View
                        android:id="@+id/tv Page2Paste"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="Paste"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="14sp" />

                    <Text View
                        android:id="@+id/tv Page2Share"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="Baidu Maps"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="14sp" />

                    <Text View
                        android:id="@+id/tv Page2Translate"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="Translate"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="14sp" />

                    <Text View
                        android:id="@+id/tv Page2Baidu"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="Baidu Translate"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="14sp" />

                    <Text View
                        android:id="@+id/tv Page2Deep Seek"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:padding Horizontal="14dp"
                        android:text="Ask Deep Seek"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="14sp" />
                </Linear Layout>
            </androidx.cardview.widget.Card View>

        </Linear Layout>
    </androidx.cardview.widget.Card View>

    <!-- Title & Description (Telegram Style) -->
    <Text View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin Top="32dp"
        android:text="Sortandhide"
        android:text Color="@color/hyper_text_primary"
        android:text Size="24sp"
        android:text Style="bold" />

    <Text View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin Top="10dp"
        android:gravity="center"
        android:line Spacing Extra="4dp"
        android:padding Horizontal="16dp"
        android:text="frequent Featurelong press Pin，rare Optionleft hide"
        android:text Color="@color/hyper_desc_text"
        android:text Size="14sp" />

</Linear Layout>