<?xml version="1.0" encoding="utf-8"?>
<Scroll View xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:fill Viewport="true"
    android:over Scroll Mode="never">

    <Linear Layout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding Bottom="32dp">

        <!-- Title row -->
        <Linear Layout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding Start="28dp"
            android:padding Top="20dp"
            android:padding End="8dp">

            <Text View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin Top="40dp"
                android:layout_weight="1"
                android:text="Hyper Select"
                android:text Color="@color/hyper_text_primary"
                android:text Size="34sp"
                android:text Style="bold" />

            <Image View
                android:id="@+id/btn Menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectable Item Background Borderless"
                android:content Description="More"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/hyper_text_primary" />
        </Linear Layout>

        <!-- status: one row, tap to view demo -->
        <Linear Layout
            android:id="@+id/card Module Status"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin Start="16dp"
            android:layout_margin Top="4dp"
            android:background="?attr/selectable Item Background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding Horizontal="12dp">

            <View
                android:id="@+id/dot Status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_circle_ok" />

            <Text View
                android:id="@+id/tv Status Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin Start="10dp"
                android:text Color="@color/hyper_text_secondary"
                android:text Size="13sp" />
        </Linear Layout>

        <!-- Three modules: one card panel with divider -->
        <Linear Layout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin Horizontal="12dp"
            android:layout_margin Top="36dp"
            android:background="@drawable/bg_sheet"
            android:clip To Outline="true"
            android:orientation="vertical">

            <Linear Layout
                android:id="@+id/card Text Action"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding Start="20dp"
                android:padding End="16dp">

                <Image View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_text_select"
                    app:tint="@color/hyper_text_primary" />

                <Linear Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin Start="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Text Selection"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin Top="2dp"
                        android:text="Long press text menu"
                        android:text Color="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </Linear Layout>

                <Text View
                    android:id="@+id/tv Text Action Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:font Family="monospace"
                    android:text Color="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <Image View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin Start="4dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </Linear Layout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_margin Start="62dp"
                android:layout_margin End="16dp"
                android:background="@color/hyper_divider" />

            <Linear Layout
                android:id="@+id/card Share Action"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding Start="20dp"
                android:padding End="16dp">

                <Image View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_share_sheet"
                    app:tint="@color/hyper_text_primary" />

                <Linear Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin Start="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Share"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin Top="2dp"
                        android:text="Share panel app list"
                        android:text Color="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </Linear Layout>

                <Text View
                    android:id="@+id/tv Share Action Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:font Family="monospace"
                    android:text Color="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <Image View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin Start="4dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </Linear Layout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_margin Start="62dp"
                android:layout_margin End="16dp"
                android:background="@color/hyper_divider" />

            <Linear Layout
                android:id="@+id/card Open With Action"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding Start="20dp"
                android:padding End="16dp">

                <Image View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_open_with"
                    app:tint="@color/hyper_text_primary" />

                <Linear Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin Start="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open With"
                        android:text Color="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <Text View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin Top="2dp"
                        android:text="File and link resolver dialog"
                        android:text Color="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </Linear Layout>

                <Text View
                    android:id="@+id/tv Open With Action Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:font Family="monospace"
                    android:text Color="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <Image View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin Start="4dp"
                    android:important For Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </Linear Layout>
        </Linear Layout>

    </Linear Layout>
</Scroll View>
