<?xml version="1.0" encoding="utf-8"?>
<Scroll View xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:fillViewport="true"
    android:overScroll Mode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_weight="1"
                android:text="HyperSelect"
                android:textColor="@color/hyper_text_primary"
                android:text Size="34sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItem BackgroundBorderless"
                android:contentDescription="More"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/hyper_text_primary" />
        </LinearLayout>

        <!-- status: one row, tap to view demo -->
        <LinearLayout
            android:id="@+id/cardModule Status"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItem Background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_circle_ok" />

            <TextView
                android:id="@+id/tvStatus Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/hyper_text_secondary"
                android:text Size="13sp" />
        </LinearLayout>

        <!-- Three modules: one card panel with divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_sheet"
            android:clipTo Outline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardText Action"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_text_select"
                    app:tint="@color/hyper_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextSelection"
                        android:textColor="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Long press text menu"
                        android:textColor="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvText ActionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="16dp"
                android:background="@color/hyper_divider" />

            <LinearLayout
                android:id="@+id/cardShare Action"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_share_sheet"
                    app:tint="@color/hyper_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SystemShare"
                        android:textColor="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Share panel app list"
                        android:textColor="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvShare ActionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="16dp"
                android:background="@color/hyper_divider" />

            <LinearLayout
                android:id="@+id/cardOpen WithAction"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_row_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_open_with"
                    app:tint="@color/hyper_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OpenWith"
                        android:textColor="@color/hyper_text_primary"
                        android:text Size="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="File and link resolver dialog"
                        android:textColor="@color/hyper_text_secondary"
                        android:text Size="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOpen WithAction Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/hyper_text_secondary"
                    android:text Size="13sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantFor Accessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</Scroll View>
