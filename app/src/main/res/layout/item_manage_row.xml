<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin Horizontal="12dp"
    android:layout_margin Vertical="3dp"
    android:background="@drawable/bg_card_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_item_ripple"
    android:gravity="center_vertical"
    android:min Height="62dp"
    android:orientation="horizontal"
    android:padding Horizontal="14dp"
    android:padding Vertical="10dp">

    <Image View
        android:id="@+id/iv App Icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:content Description="@null"
        tools:src="@mipmap/ic_launcher" />

    <Linear Layout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin Start="14dp"
        android:layout_margin End="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Text View
            android:id="@+id/tv App Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:single Line="true"
            android:text Color="@color/hyper_text_primary"
            android:text Size="15.5sp"
            tools:text="Baidu Translate" />

        <Text View
            android:id="@+id/tv Package Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin Top="2dp"
            android:ellipsize="middle"
            android:font Family="monospace"
            android:single Line="true"
            android:text Color="@color/hyper_text_secondary"
            android:text Size="11sp"
            tools:text="com.baidu.baidutranslate" />
    </Linear Layout>

    <!-- Unpin capsule（Pin Pinned items） -->
    <Text View
        android:id="@+id/btn Unpin"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_margin End="6dp"
        android:background="@drawable/bg_btn_pill_neutral"
        android:gravity="center"
        android:padding Horizontal="9dp"
        android:text="Cancel"
        android:text Color="@color/hyper_pill_grey_text"
        android:text Size="12sp"
        android:text Style="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- drag handle（Showlist） -->
    <Image View
        android:id="@+id/iv Drag Handle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?attr/selectable Item Background Borderless"
        android:content Description="Drag Sort"
        android:padding="8dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/hyper_text_secondary" />

    <!-- Pincapsule （ Showlist） -->
    <Text View
        android:id="@+id/btn Pin"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_btn_pill_primary"
        android:gravity="center"
        android:padding Horizontal="11dp"
        android:text="Pin"
        android:text Color="@color/hyper_pill_blue_text"
        android:text Size="12sp"
        android:text Style="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Restore （hide Hide ） -->
    <Image View
        android:id="@+id/btn Restore"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectable Item Background Borderless"
        android:content Description="Restore Show"
        android:padding="6dp"
        android:src="@drawable/ic_add"
        app:tint="@color/hyper_accent"
        android:visibility="gone" />

    <!-- Search Actioncapsule：Pin / hide / Restore -->
    <Linear Layout
        android:id="@+id/layout Search Actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Text View
            android:id="@+id/btn Search Pin"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_margin End="6dp"
            android:background="@drawable/bg_btn_pill_primary"
            android:gravity="center"
            android:padding Horizontal="11dp"
            android:text="Pin"
            android:text Color="@color/hyper_pill_blue_text"
            android:text Size="12sp"
            android:text Style="bold" />

        <Text View
            android:id="@+id/btn Search Hide"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_pill_neutral"
            android:gravity="center"
            android:padding Horizontal="11dp"
            android:text="hide"
            android:text Color="@color/hyper_pill_grey_text"
            android:text Size="12sp"
            android:text Style="bold" />

        <Text View
            android:id="@+id/btn Search Restore"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_pill_primary"
            android:gravity="center"
            android:padding Horizontal="11dp"
            android:text="Restore"
            android:text Color="@color/hyper_pill_blue_text"
            android:text Size="12sp"
            android:text Style="bold"
            android:visibility="gone" />
    </Linear Layout>

</Linear Layout>
