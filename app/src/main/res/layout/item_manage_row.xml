<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_card_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_item_ripple"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/hyper_text_primary"
            android:textSize="15.5sp"
            tools:text="Baidu Translate" />

        <TextView
            android:id="@+id/tvPackageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/hyper_text_secondary"
            android:textSize="11sp"
            tools:text="com.baidu.baidutranslate" />
    </LinearLayout>

    <!-- Unpin capsule（PinPinned items） -->
    <TextView
        android:id="@+id/btnUnpin"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_btn_pill_neutral"
        android:gravity="center"
        android:paddingHorizontal="9dp"
        android:text="@string/cancel"
        android:textColor="@color/hyper_pill_grey_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- drag handle（Showlist） -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="DragSort"
        android:padding="8dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/hyper_text_secondary" />

    <!-- Pincapsule （ Showlist） -->
    <TextView
        android:id="@+id/btnPin"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_btn_pill_primary"
        android:gravity="center"
        android:paddingHorizontal="11dp"
        android:text="@string/pin"
        android:textColor="@color/hyper_pill_blue_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Restore （hideHide ） -->
    <ImageView
        android:id="@+id/btnRestore"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="RestoreShow"
        android:padding="6dp"
        android:src="@drawable/ic_add"
        app:tint="@color/hyper_accent"
        android:visibility="gone" />

    <!-- Search Actioncapsule：Pin / hide / Restore -->
    <LinearLayout
        android:id="@+id/layoutSearchActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSearchPin"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_pill_primary"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="@string/pin"
            android:textColor="@color/hyper_pill_blue_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSearchHide"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_pill_neutral"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="@string/hide"
            android:textColor="@color/hyper_pill_grey_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSearchRestore"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_pill_primary"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="@string/restore"
            android:textColor="@color/hyper_pill_blue_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
