<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <!-- AnimationViewport Card (same 260dp height asPage 1 & Page 2) -->
    <androidx.cardview.widget.Card View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        app:cardBackground Color="@color/hyper_card_bg"
        app:cardCorner Radius="24dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- StatusIcon (circle: checking / ok / fail) -->
            <TextView
                android:id="@+id/tvStatus Icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_status_circle_checking"
                android:gravity="center"
                android:text="…"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.Card View>

    <!-- Title & Description (Strictly aligned withPage 1 & Page 2) -->
    <TextView
        android:id="@+id/tvStatus Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="In progressdetectModulestatus"
        android:textColor="@color/hyper_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus Desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacing Extra="4dp"
        android:paddingHorizontal="16dp"
        android:text="In progressandSystem Frameworkhandshake，please wait…"
        android:textColor="@color/hyper_desc_text"
        android:textSize="14sp" />

</LinearLayout>