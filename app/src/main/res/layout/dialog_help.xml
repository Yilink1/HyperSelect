<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding Start="28dp"
    android:padding End="28dp"
    android:padding Top="16dp"
    android:padding Bottom="24dp">

    <!-- Top Floating Sheet Handle Indicator -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin Bottom="18dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Header -->
    <Text View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usage Instructions"
        android:text Color="@color/hyper_text_primary"
        android:text Size="20sp"
        android:text Style="bold" />

    <!-- Feature Row 1: Archive -->
    <Linear Layout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Top="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Frame Layout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <Image View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help_gesture" />
        </Frame Layout>

        <Text View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin Start="16dp"
            android:layout_weight="1"
            android:text="Swipe left to hide card"
            android:text Color="@color/hyper_text_primary"
            android:text Size="16sp"
            android:text Style="bold" />
    </Linear Layout>

    <!-- Feature Row 2: Sort -->
    <Linear Layout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Top="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Frame Layout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <Image View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help_menu" />
        </Frame Layout>

        <Text View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin Start="16dp"
            android:layout_weight="1"
            android:text="Press and holdrightdrag side handle Sort"
            android:text Color="@color/hyper_text_primary"
            android:text Size="16sp"
            android:text Style="bold" />
    </Linear Layout>

    <!-- Feature Row 3: Sync -->
    <Linear Layout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Top="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Frame Layout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <Image View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_help_sync" />
        </Frame Layout>

        <Text View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin Start="16dp"
            android:layout_weight="1"
            android:text="All changes take effect immediately"
            android:text Color="@color/hyper_text_primary"
            android:text Size="16sp"
            android:text Style="bold" />
    </Linear Layout>

    <!-- Action Button -->
    <Text View
        android:id="@+id/btn Help Confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin Top="26dp"
        android:layout_margin Horizontal="10dp"
        android:background="@drawable/bg_intro_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Got it"
        android:text Color="#FFFFFF"
        android:text Size="16sp"
        android:text Style="bold" />

</Linear Layout>
