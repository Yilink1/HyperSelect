<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding Start="28dp"
    android:padding End="28dp"
    android:padding Top="16dp"
    android:padding Bottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin Bottom="18dp"
        android:background="@drawable/bg_handle_bar" />

    <Text View
        android:id="@+id/tv Help Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text Color="@color/hyper_text_primary"
        android:text Size="20sp"
        android:text Style="bold" />

    <Linear Layout
        android:id="@+id/ll Help Items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin Top="6dp"
        android:orientation="vertical" />

    <Text View
        android:id="@+id/btn Help Confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin Top="26dp"
        android:layout_margin Horizontal="10dp"
        android:background="@drawable/bg_intro_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Got it"
        android:text Color="#FFFFFF"
        android:text Size="16sp"
        android:text Style="bold" />

</Linear Layout>
