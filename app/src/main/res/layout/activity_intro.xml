<?xml version="1.0" encoding="utf-8"?>
<Linear Layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intro Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:orientation="vertical">

    <!-- Center View Pager2 -->
    <androidx.viewpager2.widget.View Pager2
        android:id="@+id/view Pager Intro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Indicator & Action Area -->
    <Linear Layout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding Horizontal="42dp"
        android:padding Bottom="36dp">

        <!-- Dot Indicators (Fluid sliding track) -->
        <Frame Layout
            android:id="@+id/layout Dots"
            android:layout_width="wrap_content"
            android:layout_height="6.5dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin Bottom="24dp">

            <!-- Background inactive dots (3 static circles) -->
            <Linear Layout
                android:layout_width="wrap_content"
                android:layout_height="6.5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot Intro1"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:background="@drawable/bg_intro_dot_inactive" />

                <View
                    android:id="@+id/dot Intro2"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:layout_margin Start="8dp"
                    android:background="@drawable/bg_intro_dot_inactive" />

                <View
                    android:id="@+id/dot Intro3"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:layout_margin Start="8dp"
                    android:background="@drawable/bg_intro_dot_inactive" />
            </Linear Layout>

            <!-- Foreground active fluid sliding noodle -->
            <View
                android:id="@+id/dot Active Pill"
                android:layout_width="6.5dp"
                android:layout_height="6.5dp"
                android:background="@drawable/bg_intro_dot_active" />
        </Frame Layout>

        <!-- Main Action Pill Button -->
        <Button
            android:id="@+id/btn Intro Action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_intro_btn"
            android:elevation="0dp"
            android:state List Animator="@null"
            android:text="Continue"
            android:text Color="#FFFFFF"
            android:text Size="16sp"
            android:text Style="bold" />
    </Linear Layout>

</Linear Layout>