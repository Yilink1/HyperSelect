<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/introRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hyper_bg"
    android:orientation="vertical">

    <!-- Center ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerIntro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Indicator & Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="42dp"
        android:paddingBottom="36dp">

        <!-- Dot Indicators (Fluid sliding track) -->
        <FrameLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="6.5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <!-- Background inactive dots (3 static circles) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="6.5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotIntro1"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:background="@drawable/bg_intro_dot_inactive" />

                <View
                    android:id="@+id/dotIntro2"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_intro_dot_inactive" />

                <View
                    android:id="@+id/dotIntro3"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_intro_dot_inactive" />
            </LinearLayout>

            <!-- Foreground active fluid sliding noodle -->
            <View
                android:id="@+id/dotActivePill"
                android:layout_width="6.5dp"
                android:layout_height="6.5dp"
                android:background="@drawable/bg_intro_dot_active" />
        </FrameLayout>

        <!-- Main Action Pill Button -->
        <Button
            android:id="@+id/btnIntroAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_intro_btn"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>